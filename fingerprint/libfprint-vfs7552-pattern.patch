diff --git a/libfprint/drivers/vfs7552_image.h b/libfprint/drivers/vfs7552_image.h
new file mode 100644
index 0000000..0407bc9
--- /dev/null
+++ b/libfprint/drivers/vfs7552_image.h
@@ -0,0 +1,75 @@
+/*
+ * Validity VFS7552 image processing, shared by the driver and offline checks.
+ *
+ * Copyright (C) 2026 Adaptive Desktop
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#pragma once
+
+#include <glib.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifndef VFS7552_IMAGE_SIZE
+#define VFS7552_IMAGE_HEIGHT 112
+#define VFS7552_IMAGE_WIDTH 112
+#define VFS7552_IMAGE_SIZE (VFS7552_IMAGE_WIDTH * VFS7552_IMAGE_HEIGHT)
+#endif
+
+static inline int
+cmp_float (const void *a, const void *b)
+{
+  float x = *(const float *) a, y = *(const float *) b;
+
+  return (x > y) - (x < y);
+}
+
+static inline float
+median_of (float *v, int n)
+{
+  qsort (v, n, sizeof (float), cmp_float);
+  return (n % 2) ? v[n / 2] : 0.5f * (v[n / 2 - 1] + v[n / 2]);
+}
+
+/* Turn a raw frame into the matcher image: finger signal relative to the
+ * empty-sensor background (both signs kept), the sensor's per-line and
+ * per-column offsets removed, and contrast stretched to the 1st..99th
+ * percentile. */
+static inline void
+process_image (const unsigned char *background, const unsigned char *raw, guint8 *out)
+{
+  g_autofree float *d = g_new (float, VFS7552_IMAGE_SIZE);
+  g_autofree float *sorted = g_new (float, VFS7552_IMAGE_SIZE);
+  float line[MAX (VFS7552_IMAGE_WIDTH, VFS7552_IMAGE_HEIGHT)];
+  float lo, hi, scale;
+
+  for (int i = 0; i < VFS7552_IMAGE_SIZE; i++)
+    d[i] = (float) background[i] - (float) raw[i];
+
+  for (int y = 0; y < VFS7552_IMAGE_HEIGHT; y++)
+    {
+      float m;
+      memcpy (line, &d[y * VFS7552_IMAGE_WIDTH], VFS7552_IMAGE_WIDTH * sizeof (float));
+      m = median_of (line, VFS7552_IMAGE_WIDTH);
+      for (int x = 0; x < VFS7552_IMAGE_WIDTH; x++)
+        d[y * VFS7552_IMAGE_WIDTH + x] -= m;
+    }
+  for (int x = 0; x < VFS7552_IMAGE_WIDTH; x++)
+    {
+      float m;
+      for (int y = 0; y < VFS7552_IMAGE_HEIGHT; y++)
+        line[y] = d[y * VFS7552_IMAGE_WIDTH + x];
+      m = median_of (line, VFS7552_IMAGE_HEIGHT);
+      for (int y = 0; y < VFS7552_IMAGE_HEIGHT; y++)
+        d[y * VFS7552_IMAGE_WIDTH + x] -= m;
+    }
+
+  memcpy (sorted, d, VFS7552_IMAGE_SIZE * sizeof (float));
+  qsort (sorted, VFS7552_IMAGE_SIZE, sizeof (float), cmp_float);
+  lo = sorted[VFS7552_IMAGE_SIZE / 100];
+  hi = sorted[VFS7552_IMAGE_SIZE - 1 - VFS7552_IMAGE_SIZE / 100];
+  scale = 255.0f / MAX (hi - lo, 1e-3f);
+  for (int i = 0; i < VFS7552_IMAGE_SIZE; i++)
+    out[i] = (guint8) CLAMP ((d[i] - lo) * scale + 0.5f, 0.0f, 255.0f);
+}
+
