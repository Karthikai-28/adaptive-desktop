diff --git a/libfprint/fpi-pattern-print.c b/libfprint/fpi-pattern-print.c
new file mode 100644
index 0000000..ca36c3a
--- /dev/null
+++ b/libfprint/fpi-pattern-print.c
@@ -0,0 +1,117 @@
+/*
+ * FpPrint storage for the pattern matcher. See fpi-pattern-print.h.
+ *
+ * Copyright (C) 2026 Adaptive Desktop
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#define FP_COMPONENT "pattern"
+
+#include "fpi-log.h"
+#include "fp-print-private.h"
+#include "fpi-pattern.h"
+#include "fpi-pattern-print.h"
+
+GVariant *
+fpi_pattern_print_data_new (GPtrArray *samples)
+{
+  GVariantBuilder arr;
+
+  g_variant_builder_init (&arr, G_VARIANT_TYPE ("aay"));
+  for (guint i = 0; samples && i < samples->len; i++)
+    {
+      GBytes *b = g_ptr_array_index (samples, i);
+      g_variant_builder_add_value (&arr, g_variant_new_from_bytes (G_VARIANT_TYPE_BYTESTRING, b, TRUE));
+    }
+  return g_variant_new ("(u@aay)", FPI_PATTERN_MAGIC, g_variant_builder_end (&arr));
+}
+
+/* Samples of a pattern print, or NULL if @print is not one. */
+static GPtrArray *
+pattern_samples (FpPrint *print)
+{
+  g_autoptr(GVariant) arr = NULL;
+  GPtrArray *out;
+  guint32 magic;
+
+  if (!print || print->type != FPI_PRINT_RAW || !print->data ||
+      !g_variant_is_of_type (print->data, G_VARIANT_TYPE (FPI_PATTERN_VARIANT_TYPE)))
+    return NULL;
+
+  g_variant_get (print->data, "(u@aay)", &magic, &arr);
+  if (magic != FPI_PATTERN_MAGIC)
+    return NULL;
+
+  out = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+  for (gsize i = 0; i < g_variant_n_children (arr); i++)
+    {
+      g_autoptr(GVariant) child = g_variant_get_child_value (arr, i);
+      g_ptr_array_add (out, g_variant_get_data_as_bytes (child));
+    }
+  return out;
+}
+
+FpPrint *
+fpi_pattern_print_new_from_image (FpDevice *device, FpImage *image, GError **error)
+{
+  g_autoptr(GPtrArray) samples = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+  g_autoptr(GError) local_error = NULL;
+  GBytes *features;
+  FpPrint *print;
+
+  features = fpi_pattern_extract (image->data, image->width, image->height, &local_error);
+  if (!features)
+    {
+      fp_dbg ("Pattern extraction failed: %s", local_error->message);
+      g_propagate_error (error, fpi_device_retry_new_msg (FP_DEVICE_RETRY_CENTER_FINGER,
+                                                          "Not enough of the finger was seen, please retry"));
+      return NULL;
+    }
+  fp_dbg ("Pattern sample with %u keypoints", fpi_pattern_count (features));
+  g_ptr_array_add (samples, features);
+
+  print = fp_print_new (device);
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  g_object_set (print, "fpi-data", fpi_pattern_print_data_new (samples), NULL);
+  return print;
+}
+
+void
+fpi_pattern_print_append (FpPrint *enroll_print, FpPrint *sample)
+{
+  g_autoptr(GPtrArray) have = pattern_samples (enroll_print);
+  g_autoptr(GPtrArray) add = pattern_samples (sample);
+
+  g_return_if_fail (add != NULL);
+  if (!have)
+    have = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+  for (guint i = 0; i < add->len; i++)
+    g_ptr_array_add (have, g_bytes_ref (g_ptr_array_index (add, i)));
+
+  g_object_set (enroll_print, "fpi-data", fpi_pattern_print_data_new (have), NULL);
+}
+
+FpiMatchResult
+fpi_pattern_print_match (FpPrint *template_print, FpPrint *probe, gint threshold)
+{
+  g_autoptr(GPtrArray) gallery = pattern_samples (template_print);
+  g_autoptr(GPtrArray) probes = pattern_samples (probe);
+  gint best = 0;
+
+  /* Templates from another matcher (e.g. old bozorth3 enrollments) never match. */
+  if (!gallery || !probes || probes->len != 1)
+    {
+      fp_dbg ("Template is not a pattern print; enroll this finger again");
+      return FPI_MATCH_FAIL;
+    }
+
+  for (guint i = 0; i < gallery->len; i++)
+    {
+      gint score = fpi_pattern_score (g_ptr_array_index (probes, 0), g_ptr_array_index (gallery, i));
+      best = MAX (best, score);
+      if (score >= threshold)
+        break;
+    }
+  fp_dbg ("pattern score %d/%d over %u samples", best, threshold, gallery->len);
+
+  return best >= threshold ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL;
+}
