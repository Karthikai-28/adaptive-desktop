+
+#include <opencv2/calib3d.hpp>
+#include <opencv2/core.hpp>
+#include <opencv2/features2d.hpp>
+#include <opencv2/imgproc.hpp>
+
+namespace {
+
+constexpr int DESC = 128;            /* SIFT descriptor length */
+constexpr int MAX_KEYPOINTS = 600;   /* strongest kept per sample */
+constexpr int MIN_KEYPOINTS = 40;    /* fewer means no usable ridge texture */
+constexpr float RATIO = 0.8f;        /* Lowe ratio test */
+constexpr double REPROJ_PX = 4.0;    /* RANSAC inlier distance */
+
+struct __attribute__((packed)) Header
+{
+  guint32 magic;
+  guint32 count;
+};
+
+struct __attribute__((packed)) Point
+{
+  float  x;
+  float  y;
+  guint8 desc[DESC];
+};
+
+bool
+unpack (GBytes *blob, std::vector<cv::Point2f> &pts, cv::Mat &desc)
+{
+  gsize len = 0;
+  const guint8 *data = blob ? (const guint8 *) g_bytes_get_data (blob, &len) : nullptr;
+  Header h;
+
+  if (!data || len < sizeof (Header))
+    return false;
+  memcpy (&h, data, sizeof (h));
+  if (h.magic != FPI_PATTERN_MAGIC || len != sizeof (Header) + (gsize) h.count * sizeof (Point))
+    return false;
+
+  pts.resize (h.count);
+  desc.create (h.count, DESC, CV_32F);
+  for (guint32 i = 0; i < h.count; i++)
+    {
+      Point p;
+      memcpy (&p, data + sizeof (Header) + i * sizeof (Point), sizeof (p));
+      pts[i] = cv::Point2f (p.x, p.y);
+      float *row = desc.ptr<float> (i);
+      for (int k = 0; k < DESC; k++)
+        row[k] = p.desc[k];
+    }
+  return true;
+}
+
+} // namespace
+
+extern "C" GBytes *
+fpi_pattern_extract (const guint8 *data, gint width, gint height, GError **error)
+{
+  try
+    {
+      cv::Mat img (height, width, CV_8UC1, (void *) data);
+      cv::Mat big, eq, smooth, desc;
+      std::vector<cv::KeyPoint> kps;
+
+      /* Native small-sensor images are enlarged so ridges span enough pixels
+       * for the descriptor scale. */
+      if (width < 160)
+        cv::resize (img, big, cv::Size (width * 2, height * 2), 0, 0, cv::INTER_CUBIC);
+      else
+        big = img;
+      cv::createCLAHE (2.0, cv::Size (4, 4))->apply (big, eq);
+      cv::GaussianBlur (eq, smooth, cv::Size (3, 3), 0);
+      auto sift = cv::SIFT::create (0, 3, 0.02, 10);
+      sift->detect (smooth, kps);
+      cv::KeyPointsFilter::retainBest (kps, MAX_KEYPOINTS);
+      sift->compute (smooth, kps, desc);
+
+      if ((int) kps.size () < MIN_KEYPOINTS || desc.rows != (int) kps.size ())
+        {
+          g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                       "Too little ridge texture (%zu keypoints)", kps.size ());
+          return NULL;
+        }
+
+      Header h = { FPI_PATTERN_MAGIC, (guint32) kps.size () };
+      gsize len = sizeof (Header) + kps.size () * sizeof (Point);
+      guint8 *out = (guint8 *) g_malloc (len);
+      memcpy (out, &h, sizeof (h));
+      for (size_t i = 0; i < kps.size (); i++)
+        {
+          Point p;
+          p.x = kps[i].pt.x;
+          p.y = kps[i].pt.y;
+          const float *row = desc.ptr<float> ((int) i);
+          for (int k = 0; k < DESC; k++)
+            p.desc[k] = (guint8) std::min (255.0f, std::max (0.0f, std::round (row[k])));
+          memcpy (out + sizeof (Header) + i * sizeof (Point), &p, sizeof (p));
+        }
+      return g_bytes_new_take (out, len);
+    }
+  catch (const cv::Exception &e)
+    {
+      g_set_error (error, G_IO_ERROR, G_IO_ERROR_FAILED, "Feature extraction failed: %s", e.what ());
+      return NULL;
+    }
+}
+
+extern "C" gint
+fpi_pattern_score (GBytes *probe, GBytes *sample)
+{
+  std::vector<cv::Point2f> pa, pb;
+  cv::Mat da, db;
+
+  if (!unpack (probe, pa, da) || !unpack (sample, pb, db))
+    return 0;
+
+  try
+    {
+      std::vector<std::vector<cv::DMatch>> knn;
+      std::vector<cv::Point2f> src, dst;
+      cv::Mat inliers;
+
+      cv::BFMatcher (cv::NORM_L2).knnMatch (da, db, knn, 2);
+      for (const auto &m : knn)
+        if (m.size () == 2 && m[0].distance < RATIO * m[1].distance)
+          {
+            src.push_back (pa[m[0].queryIdx]);
+            dst.push_back (pb[m[0].trainIdx]);
+          }
+      if (src.size () < 3)
+        return 0;
+
+      /* Deterministic RANSAC: same scans, same score. */
+      cv::theRNG ().state = 0x5eed;
+      cv::Mat M = cv::estimateAffinePartial2D (src, dst, inliers, cv::RANSAC,
+                                               REPROJ_PX, 2000, 0.995);
+      if (M.empty ())
+        return 0;
+
+      /* A finger on the same sensor keeps its scale. */
+      double scale = std::hypot (M.at<double> (0, 0), M.at<double> (1, 0));
+      if (scale < 0.85 || scale > 1.15)
+        return 0;
+
+      return cv::countNonZero (inliers);
+    }
+  catch (const cv::Exception &)
+    {
+      return 0;
+    }
+}
+
+extern "C" guint
+fpi_pattern_count (GBytes *features)
+{
+  std::vector<cv::Point2f> p;
+  cv::Mat d;
+
+  return unpack (features, p, d) ? (guint) p.size () : 0;
+}
diff --git a/libfprint/fpi-pattern.h b/libfprint/fpi-pattern.h
new file mode 100644
index 0000000..cade3b0
--- /dev/null
+++ b/libfprint/fpi-pattern.h
@@ -0,0 +1,36 @@
+/*
+ * Pattern matcher for small press sensors.
+ *
+ * Bozorth3 compares minutiae and needs a fingertip-sized image; a 6 mm sensor
+ * yields ~12 minutiae, too few to match. This matcher instead describes the
+ * ridge texture with SIFT keypoints and counts the keypoint correspondences
+ * that agree on one rigid placement of the finger (RANSAC). Different fingers
+ * do not agree on a placement, so their count stays near zero.
+ *
+ * Copyright (C) 2026 Adaptive Desktop
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#pragma once
+
+#include <glib.h>
+
+G_BEGIN_DECLS
+
+/* Feature blob magic and print-data format ("(uaay)": magic, samples). */
+#define FPI_PATTERN_MAGIC 0x41465031u /* "AFP1" */
+#define FPI_PATTERN_VARIANT_TYPE "(uaay)"
+
+/* Extract features from an 8-bit image; NULL + error if the image is unusable. */
+GBytes *fpi_pattern_extract (const guint8 *data,
+                             gint          width,
+                             gint          height,
+                             GError      **error);
+
+/* Number of keypoint correspondences consistent with one finger placement. */
+gint fpi_pattern_score (GBytes *probe,
+                        GBytes *sample);
+
+/* Number of keypoints in a feature blob (0 if invalid). */
+guint fpi_pattern_count (GBytes *features);
+
+G_END_DECLS
