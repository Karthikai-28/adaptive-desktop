@@ -0,0 +1,32 @@
+/*
+ * FpPrint storage for the pattern matcher (fpi-pattern.h).
+ *
+ * A pattern print is an FPI_PRINT_RAW print whose data is
+ * FPI_PATTERN_VARIANT_TYPE: the format magic and one feature blob per
+ * enrollment touch. A probe print holds a single blob.
+ *
+ * Copyright (C) 2026 Adaptive Desktop
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#pragma once
+
+#include "fpi-device.h"
+#include "fpi-image.h"
+#include "fpi-print.h"
+
+G_BEGIN_DECLS
+
+GVariant       *fpi_pattern_print_data_new (GPtrArray *samples);
+
+FpPrint        *fpi_pattern_print_new_from_image (FpDevice *device,
+                                                  FpImage  *image,
+                                                  GError  **error);
+
+void            fpi_pattern_print_append (FpPrint *enroll_print,
+                                          FpPrint *sample);
+
+FpiMatchResult  fpi_pattern_print_match (FpPrint *template_print,
+                                         FpPrint *probe,
+                                         gint     threshold);
+
+G_END_DECLS
