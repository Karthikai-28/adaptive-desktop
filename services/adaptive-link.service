[Unit]
Description=Adaptive Link: this computer, from the owner's paired phone
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 @ADAPTIVE_REPO@/services/adaptive-link/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
