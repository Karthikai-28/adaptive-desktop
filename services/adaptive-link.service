[Unit]
Description=Adaptive Link: this computer, from the owner's paired phone
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 @ADAPTIVE_REPO@/services/adaptive-link/server.py
# A clean exit is still an outage: the phone has no other laptop-side
# process to reconnect to.  Keep the link present for the whole session.
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
