#!/usr/bin/env python3
"""office - drive the Agent Office from a terminal (Claude, the manager, uses this too).

  office status                                   team status, queues, quota
  office assign <agent> "<title>" [--body TEXT] [--project NAME] [--after ID] [--repo PATH|NAME]
  office repos                              repos every agent can read (--repo makes one writable for a task)
  office tasks [--agent A] [--status queued,running,done,failed] [-n N]
  office show <task id>                           full task with its report and activity
  office cancel <task id> | office retry <task id>
  office mission create "<title>" --objective TEXT --criterion TEXT [--agent ID] [--repo PATH|NAME]
  office mission ros "<observed problem>" [--bag PATH] [--repo PATH|NAME]
  office mission list | office mission show <id> | office mission cancel <id> | office mission export <id>
  office capsule create [--mission ID] [--command CMD] [--dataset REF] [--result REF]
  office capsule list | office capsule show <id>
  office evidence "search words" [--mission ID]
  office workflow create ID "Title" --objective TEXT --criterion TEXT [--risk read|write|hardware|external]
                         [--allowed-agent ID]   (or --from-mission ID instead of --objective/--criterion)
  office workflow list | office workflow show ID | office workflow run ID [--input NAME=VALUE] [--approve]
  office retention DAYS [--kind capsules|exports] [--apply]   (--apply needs the operator)
  office operator-key                             the key that lets the office app approve runs (owner only)
  office ask <agent> "<message>" [--no-wait]      direct message; waits for the reply
  office log [--agent A] [-n N]                   recent activity
  office meeting start "<topic>" --with maya,arjun[,claude]
  office meeting say "<text>" | office meeting invite a,b | office meeting end | office meeting show
  office study [status|pause|resume|now] [PROGRAM]  a learning program (e.g. Max studying the MKE repos)
  office provider [ID] [--fallback ID|none]       which model provider agents run on (gemini, codex, haiku, local)
  office tokens [--since 24h] [--provider ID]     token usage, split by provider
  office autopilot on|off | office pause | office resume
  office open                                     open the office in the browser
"""
import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

URL = os.environ.get("OFFICE_URL", "http://127.0.0.1:8790").rstrip("/")
STATE = Path(os.environ.get("OFFICE_STATE") or Path.home() / ".local/share/adaptive-desktop/agent-office")
KEY_FILE = STATE / "data" / "operator.key"


def _actor():
    """Who is running this command. The manager's Claude starts with OFFICE_ACTOR=manager; its commands are
    recognised by that ancestor whatever their own environment says, so they never carry the operator key."""
    claimed = os.environ.get("OFFICE_ACTOR", "operator")
    pid = os.getpid()
    for _ in range(64):
        try:
            env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            break
        if b"OFFICE_ACTOR=manager" in env:
            return "manager"
        pid = int(stat.rsplit(")", 1)[1].split()[1])
        if pid <= 1:
            break
    return claimed if claimed in ("operator", "manager") else "operator"


ACTOR = _actor()


def operator_key():
    if ACTOR != "operator":
        return ""
    try:
        return KEY_FILE.read_text().strip()
    except OSError:
        return ""


def call(method, path, body=None, query=None):
    url = URL + path + ("?" + urllib.parse.urlencode({k: v for k, v in (query or {}).items() if v is not None})
                        if query else "")
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json", "X-Office": "1", "X-Office-Actor": ACTOR}
    key = operator_key()
    if key:
        headers["X-Office-Operator"] = key
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read()).get("detail") or e.reason
        except Exception:
            detail = e.reason
        sys.exit(f"office: {detail}")
    except urllib.error.URLError:
        sys.exit(f"office: the office server is not running at {URL} "
                 "(start it: systemctl --user start adaptive-agent-office)")


def ago(ts):
    if not ts:
        return ""
    s = int(time.time() - ts)
    return f"{s}s" if s < 90 else f"{s // 60}m" if s < 5400 else f"{s // 3600}h"


def names(state):
    return {p["id"]: p["name"] for p in state["roster"]}


def cmd_status(a):
    st = call("GET", "/api/state")
    n = names(st)
    s = st["settings"]
    provs = {p["id"]: p for p in st.get("providers", [])}
    label = lambda pid: f"{provs[pid]['label']} ({provs[pid]['model']})" if pid in provs else (pid or "-")
    print(f"{st['company']} — agents on {label(s.get('provider'))}"
          + (f", fallback {label(s['fallback'])}" if s.get("fallback") else ""))
    for p in provs.values():
        if p["engine"] == "ollama":
            state = ("not running" if not p.get("up") else "model not pulled" if not p.get("pulled")
                     else "loaded" if p.get("loaded") else "ready")
            print(f"  {p['label']}: Ollama {p.get('version') or ''} {p['model']} - {state}")
    flags = [f"autopilot {'on' if s['autopilot'] else 'off'}", f"max parallel {s['max_parallel']}"]
    if s["paused"]:
        flags.append("OFFICE PAUSED - nothing runs until `office resume`")
    if st["quota_until"] > time.time():
        flags.append(f"Gemini quota pause for {int((st['quota_until'] - time.time()) / 60)} more min")
    print("  " + ", ".join(flags))
    if st.get("meeting"):
        m = st["meeting"]
        print(f"  meeting running: \"{m['topic']}\" with {', '.join(n.get(x, x) for x in m['attendees'])}")
    print()
    roles = {p["id"]: p["role"] for p in st["roster"]}
    for ag in st["agents"]:
        line = f"  {n[ag['id']]:<8} {roles[ag['id']]:<22} {ag['status']:<9}" + (
            f" [{provs.get(ag['provider'], {}).get('label', ag['provider'])}]" if ag.get("provider") else "")
        if ag["task"]:
            line += f" #{ag['task']['id']} {ag['task']['title'][:50]}"
        if ag["queued"]:
            line += f"  (+{ag['queued']} queued)"
        if ag["in_meeting"]:
            line += "  [in meeting]"
        print(line)
        if ag["activity"] and ag["status"] != "idle":
            print(f"  {'':<8} └ {ag['activity'][:90]}  ({ago(ag['activity_ts'])} ago)")


def cmd_assign(a):
    t = call("POST", "/api/tasks", {"agent": a.agent.lower(), "title": a.title, "body": a.body or "",
                                    "project": a.project or "", "after": a.after, "created_by": ACTOR,
                                    "repo": a.repo or ""})
    dep = f", starts after #{t['depends_on']}" if t["depends_on"] else ""
    rw = f", may change {t['repo']}" if t.get("repo") else ""
    print(f"task #{t['id']} assigned to {t['agent']}{dep}{rw}: {t['title']}")


def cmd_repos(a):
    r = call("GET", "/api/repos")
    if not r["enabled"]:
        print("repo access is off (config.json \"repos\": {\"all\": false})")
    home = os.path.expanduser("~")
    for p in r["repos"]:
        print(p.replace(home, "~", 1))


def cmd_tasks(a):
    for t in call("GET", "/api/tasks", query={"agent": a.agent, "status": a.status, "limit": a.n}):
        dep = f" after #{t['depends_on']}" if t["depends_on"] else ""
        proj = f" [{t['project']}]" if t["project"] else ""
        print(f"#{t['id']:<4} {t['status']:<9} {t['agent']:<7} {t['title'][:70]}{proj}{dep}  ({ago(t['created_at'])} ago)")


def cmd_show(a):
    t = call("GET", f"/api/tasks/{a.id}")
    print(f"#{t['id']} {t['title']}\n  agent {t['agent']}  status {t['status']}  by {t['created_by']}"
          f"  project {t['project'] or '-'}  steps {t['steps']}  tokens {t['tokens']}")
    if t.get("repo"):
        print(f"  writable repo {t['repo']}")
    if t["body"]:
        print(f"\nDetails:\n{t['body']}")
    if t["error"]:
        print(f"\nError: {t['error']}")
    if t["result"]:
        print(f"\nReport:\n{t['result']}")
    if a.events:
        print("\nActivity:")
        for e in t["events"]:
            print(f"  {time.strftime('%H:%M:%S', time.localtime(e['ts']))} {e['text']}")


def cmd_cancel(a):
    t = call("POST", f"/api/tasks/{a.id}/cancel")
    print(f"#{t['id']} {t['status']}")


def cmd_retry(a):
    t = call("POST", f"/api/tasks/{a.id}/retry")
    print(f"#{t['id']} {t['status']}")


def cmd_mission(a):
    if a.action == "ros":
        m = call("POST", "/api/missions/ros-investigation", {"agent": a.agent, "title": a.name or "Investigate ROS 2 failure",
                 "problem": a.title, "bag": a.bag or "", "baseline_bag": a.baseline_bag or "",
                 "simulation_command": a.simulation_command or "", "project": a.project or "", "repo": a.repo or ""})
        print(f"ROS investigation #{m['id']} {m['status']} (task #{m['tasks'][0]['id']})")
        if m.get("capsule_error"):
            print(f"  the work capsule could not be saved: {m['capsule_error']}")
        return
    if a.action == "create":
        m = call("POST", "/api/missions", {"agent": a.agent, "title": a.title,
                 "objective": a.objective, "criteria": a.criterion or [],
                 "project": a.project or "", "repo": a.repo or ""})
        print(f"mission #{m['id']} {m['status']}: {m['title']} (task #{m['tasks'][0]['id']})")
        return
    if a.action == "cancel":
        m = call("POST", f"/api/missions/{a.id}/cancel")
        print(f"mission #{m['id']} {m['status']}")
        return
    if a.action == "export":
        x = call("POST", f"/api/missions/{a.id}/export")
        print(f"mission #{a.id} audit exported to {x['path']} ({x['bytes']} bytes, sha256 {x['sha256']})")
        return
    if a.action == "show":
        rows = [call("GET", f"/api/missions/{a.id}")]
    else:
        rows = call("GET", "/api/missions", query={"limit": a.n})
    for m in rows:
        print(f"#{m['id']:<4} {m['status']:<10} {m['title']}")
        if a.action == "show":
            print(f"  risk: {m.get('risk') or '-'}  by: {m.get('created_by')}"
                  + (f"  workflow: {m['workflow_id']}" if m.get("workflow_id") else "")
                  + (f"  approved by: {m['approved_by']}" if m.get("approved_by") else ""))
            print(f"  objective: {m['objective']}")
            verdict = {v["id"]: v for v in m.get("verdicts") or []}
            for i, criterion in enumerate(m["criteria"], 1):
                v = verdict.get(f"C{i}")
                print(f"  C{i} [{v['verdict'] if v else '    '}] {criterion}"
                      + (f"\n       {v['evidence']}" if v and v["evidence"] else ""))
            for t in m.get("tasks", []):
                print(f"  task #{t['id']} {t['status']}: {t['title']} ({t['agent']})")
            if m.get("summary"):
                print(f"\nEvidence report:\n{m['summary']}")
            if m.get("error"):
                print(f"\nError: {m['error']}")


def cmd_capsule(a):
    if a.action == "create":
        params = {}
        for item in a.parameter or []:
            if "=" not in item:
                sys.exit("office: --parameter must be NAME=VALUE")
            k, v = item.split("=", 1); params[k.strip()] = v.strip()
        c = call("POST", "/api/capsules", {"mission_id": a.mission, "project": a.project or "",
                 "repo": a.repo or "", "command": a.command or "", "launch_args": a.arg or [],
                 "parameters": params, "datasets": a.dataset or [], "results": a.result or [],
                 "notes": a.notes or ""})
        print(f"capsule {c['id']} saved to {c['path']}")
        return
    if a.action == "show":
        c = call("GET", f"/api/capsules/{a.id}")
        print(json.dumps(c, indent=2))
        return
    for c in call("GET", "/api/capsules", query={"limit": a.n}):
        print(f"{c['id']}  mission #{c['mission_id'] or '-'}  {c['project'] or '-'}  {c['mission'] or ''}")


def cmd_evidence(a):
    d = call("GET", "/api/evidence/search", query={"q": a.query, "mission_id": a.mission, "limit": a.n})
    for r in d["results"]:
        print(f"[{r['kind']}] {r['title']}  {r['ref']}\n  {r['snippet']}")
    if not d["results"]:
        print(f"no matching evidence ({d['scanned_files']} files scanned)")
    if d.get("truncated"):
        print(f"(search stopped after {d['scanned_files']} files; narrow it with more words)")


def cmd_workflow(a):
    if a.action == "create":
        w = call("POST", "/api/workflows", {"id": a.id, "title": a.title, "description": a.description or "",
                 "objective": a.objective or "", "criteria": a.criterion or [], "agent": a.agent or "",
                 "project": a.project or "", "repo": a.repo or "", "risk": a.risk,
                 "allowed_agents": a.allowed_agent or [], "from_mission": a.from_mission})
        print(f"workflow {w['id']} saved")
        return
    if a.action == "show":
        print(json.dumps(call("GET", f"/api/workflows/{a.id}"), indent=2)); return
    if a.action == "run":
        inputs = {}
        for item in a.input or []:
            if "=" not in item: sys.exit("office: --input must be NAME=VALUE")
            k, v = item.split("=", 1); inputs[k.strip()] = v.strip()
        m = call("POST", f"/api/workflows/{a.id}/run", {"inputs": inputs, "agent": a.agent or "",
                 "project": a.project or "", "repo": a.repo or "", "approved": a.approve})
        print(f"workflow launched mission #{m['id']}: {m['title']}"); return
    for w in call("GET", "/api/workflows"):
        print(f"{w['id']:<28} {w['risk']:<8} {w['title']}")


def cmd_retention(a):
    d = call("POST", "/api/retention", {"days": a.days, "kinds": a.kind or ["capsules", "exports"],
                                         "apply": a.apply})
    action = "deleted" if a.apply else "would delete"
    print(f"{action} {d['count']} file(s), {d['bytes']} bytes")
    for row in d["files"]:
        print(f"  {row['path']}")
    if d.get("kept_mission_capsules"):
        print(f"kept {d['kept_mission_capsules']} old capsule(s) that belong to a mission")


def cmd_operator_key(a):
    if ACTOR != "operator":
        sys.exit("office: only the owner can read the operator key")
    key = operator_key()
    if not key:
        sys.exit(f"office: no operator key yet at {KEY_FILE} (start the office once)")
    print(key)


def cmd_ask(a):
    to = a.agent.lower()
    m = call("POST", "/api/chat", {"to": to, "text": a.message,
                                   "sender": "claude" if ACTOR == "manager" else "operator"})
    if a.no_wait:
        print("sent")
        return
    thread = "manager" if to == "claude" else f"dm:{to}"
    deadline = time.time() + a.timeout
    while time.time() < deadline:
        time.sleep(3)
        for r in call("GET", "/api/messages", query={"thread": thread, "after": m["id"]}):
            if r["sender"] == to:
                print(r["text"])
                return
    sys.exit(f"office: no reply from {to} within {a.timeout}s (it will still appear in the office)")


def cmd_log(a):
    st = call("GET", "/api/state")
    n = names(st)
    for e in call("GET", "/api/events", query={"agent": a.agent, "limit": a.n}):
        print(f"{time.strftime('%H:%M:%S', time.localtime(e['ts']))} {n.get(e['agent'], e['agent']):<7} {e['text']}")


def cmd_meeting(a):
    if a.action == "start":
        who = [x.strip().lower() for x in (a.with_ or "").split(",") if x.strip()]
        if not who:
            sys.exit("office: say who attends, e.g. --with maya,arjun,claude")
        m = call("POST", "/api/meeting/start", {"topic": a.text or "", "attendees": who})
        print(f"meeting #{m['id']} started: {m['topic']}")
    elif a.action == "say":
        call("POST", "/api/meeting/say", {"text": a.text})
        print("said")
    elif a.action == "invite":
        call("POST", "/api/meeting/invite", {"attendees": [x.strip().lower() for x in a.text.split(",")]})
        print("invited")
    elif a.action == "end":
        m = call("POST", "/api/meeting/end")
        print(f"meeting ended; notes in {m['minutes_path']}")
    else:
        d = call("GET", "/api/meeting")
        if not d["meeting"]:
            print("no meeting is running")
            return
        print(f"meeting #{d['meeting']['id']}: {d['meeting']['topic']}")
        for msg in d["messages"]:
            print(f"  {msg['sender']}: {msg['text']}")


def cmd_study(a):
    progs = call("GET", "/api/study")
    if not progs:
        print("no study programs (add one under \"studies\" in config.json)")
        return
    if a.action != "status":
        pid = a.program or progs[0]["id"]
        progs = [call("POST", f"/api/study/{pid}/{a.action}")]
    for p in progs:
        state = "active" if p["active"] else "paused"
        print(f"{p['id']}: {p['title']} - {p['agent']} - {state}, {p['sessions']} session(s), "
              f"{p['today']}/{p['max_per_day']} today")
        if p["current"]:
            print(f"  now: #{p['current']['id']} {p['current']['title']} ({p['current']['status']})")
        elif p["active"] and p["next_at"]:
            wait = int(p["next_at"] - time.time())
            print(f"  next session {'now' if wait <= 0 else f'in {wait // 60} min'}")
        pr = p.get("progress") or {}
        topics = pr.get("topics") or []
        if topics:
            avg = sum(t.get("mastery", 0) for t in topics) / len(topics)
            q = pr.get("questions") or {}
            print(f"  {len(topics)} topics, average mastery {avg:.1f}/5, questions {q.get('answered', 0)} answered / {q.get('open', 0)} open")
            for t in sorted(topics, key=lambda t: -t.get("mastery", 0))[:a.n]:
                print(f"    {'#' * int(t.get('mastery', 0)):<5} {t.get('mastery', 0)}  {t.get('title', t.get('id'))} [{t.get('repo', '')}]")
        if p["latest_report"]:
            print(f"  latest report: {p['latest_report']}")
        missing = [r["path"] for r in p["repos"] if not r["present"]]
        if missing:
            print(f"  not on this machine: {', '.join(missing)}")


def cmd_settings(a, **kw):
    s = call("POST", "/api/settings", kw)
    print(", ".join(f"{k}={v}" for k, v in s.items()))


def cmd_provider(a):
    st = call("GET", "/api/state")
    kw = {}
    if a.id:
        kw["provider"] = a.id
    if a.fallback:
        kw["fallback"] = "" if a.fallback == "none" else a.fallback
    s = call("POST", "/api/settings", kw) if kw else st["settings"]
    provs = {p["id"]: p for p in st.get("providers", [])}
    chain, nxt = [s["provider"]], s.get("fallback")
    while nxt and nxt in provs and nxt not in chain:      # each fallback can name its own fallback
        chain.append(nxt)
        nxt = provs[nxt].get("fallback")
    for p in provs.values():
        i = chain.index(p["id"]) if p["id"] in chain else -1
        tag = " <- agents" if i == 0 else f" <- fallback {i}" if i > 0 else ""
        extra = ""
        if p["engine"] == "ollama":
            extra = ("  (Ollama not running)" if not p.get("up") else "  (model not pulled)" if not p.get("pulled") else "")

        print(f"  {p['id']:<10} {p['engine']:<7} {p['model']}{extra}{tag}")


def _since(text):
    if not text or text == "all":
        return 0
    n, unit = int(text[:-1]), text[-1]
    return time.time() - n * {"m": 60, "h": 3600, "d": 86400}[unit]


def cmd_tokens(a):
    d = call("GET", "/api/tokens", query={"since": _since(a.since), "provider": a.provider})
    print(f"token usage, {'all time' if a.since == 'all' else 'last ' + a.since}"
          + (f", provider {a.provider}" if a.provider else ""))
    print(f"  {'provider':<18} {'total':>12} {'new':>11} {'calls':>7}  model")
    for p in d["providers"]:
        if p["calls"] or p["engine"] != "claude":
            print(f"  {p['label']:<18} {p['total']:>12,} {p['new']:>11,} {p['calls']:>7,}  {p['model']}")
    print()
    n = {}
    try:
        n = names(call("GET", "/api/state"))
    except SystemExit:
        pass
    for ag in d["agents"]:
        split = "  ".join(f"{k} {v:,}" for k, v in sorted(ag.get("providers", {}).items(), key=lambda x: -x[1]))
        print(f"  {n.get(ag['id'], ag['id']):<10} {ag['total']:>12,}  {split}")


def main():
    p = argparse.ArgumentParser(prog="office", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("status")
    sub.add_parser("help")
    s = sub.add_parser("assign"); s.add_argument("agent"); s.add_argument("title")
    s.add_argument("--body", "-b"); s.add_argument("--project", "-p"); s.add_argument("--after", type=int)
    s.add_argument("--repo", "-r", help="a repo this task may change (path or folder name)")
    sub.add_parser("repos")
    s = sub.add_parser("tasks"); s.add_argument("--agent"); s.add_argument("--status"); s.add_argument("-n", type=int, default=30)
    s = sub.add_parser("show"); s.add_argument("id", type=int); s.add_argument("--events", action="store_true")
    s = sub.add_parser("cancel"); s.add_argument("id", type=int)
    s = sub.add_parser("retry"); s.add_argument("id", type=int)
    s = sub.add_parser("mission"); s.add_argument("action", choices=["create", "ros", "list", "show", "cancel", "export"])
    s.add_argument("title", nargs="?")
    s.add_argument("--objective"); s.add_argument("--criterion", action="append")
    s.add_argument("--agent", default="maya"); s.add_argument("--project"); s.add_argument("--repo")
    s.add_argument("--bag"); s.add_argument("--baseline-bag"); s.add_argument("--simulation-command"); s.add_argument("--name")
    s.add_argument("-n", type=int, default=30)
    s = sub.add_parser("capsule"); s.add_argument("action", choices=["create", "list", "show"])
    s.add_argument("id", nargs="?"); s.add_argument("--mission", type=int); s.add_argument("--project"); s.add_argument("--repo")
    s.add_argument("--command"); s.add_argument("--arg", action="append"); s.add_argument("--parameter", action="append")
    s.add_argument("--dataset", action="append"); s.add_argument("--result", action="append"); s.add_argument("--notes")
    s.add_argument("-n", type=int, default=30)
    s = sub.add_parser("evidence"); s.add_argument("query"); s.add_argument("--mission", type=int); s.add_argument("-n", type=int, default=40)
    s = sub.add_parser("workflow"); s.add_argument("action", choices=["create", "list", "show", "run"])
    s.add_argument("id", nargs="?"); s.add_argument("title", nargs="?"); s.add_argument("--description")
    s.add_argument("--objective"); s.add_argument("--criterion", action="append"); s.add_argument("--agent")
    s.add_argument("--project"); s.add_argument("--repo"); s.add_argument("--risk", default="write")
    s.add_argument("--allowed-agent", action="append"); s.add_argument("--input", action="append")
    s.add_argument("--from-mission", type=int, help="copy objective, criteria and scope from this mission")
    s.add_argument("--approve", action="store_true", help="approve this hardware/external workflow run")
    s = sub.add_parser("retention"); s.add_argument("days", type=int)
    s.add_argument("--kind", action="append", choices=["capsules", "exports"])
    s.add_argument("--apply", action="store_true")
    sub.add_parser("operator-key")
    s = sub.add_parser("ask"); s.add_argument("agent"); s.add_argument("message")
    s.add_argument("--no-wait", action="store_true"); s.add_argument("--timeout", type=int, default=900)
    s = sub.add_parser("log"); s.add_argument("--agent"); s.add_argument("-n", type=int, default=40)
    s = sub.add_parser("meeting"); s.add_argument("action", choices=["start", "say", "invite", "end", "show"])
    s.add_argument("text", nargs="?"); s.add_argument("--with", dest="with_")
    s = sub.add_parser("autopilot"); s.add_argument("state", choices=["on", "off"])
    s = sub.add_parser("study"); s.add_argument("action", nargs="?", default="status", choices=["status", "pause", "resume", "now"])
    s.add_argument("program", nargs="?"); s.add_argument("-n", type=int, default=12)
    s = sub.add_parser("provider"); s.add_argument("id", nargs="?"); s.add_argument("--fallback")
    s = sub.add_parser("tokens"); s.add_argument("--since", default="24h"); s.add_argument("--provider")
    sub.add_parser("pause"); sub.add_parser("resume"); sub.add_parser("open")
    a = p.parse_args()
    if a.cmd == "mission":
        if a.action == "create" and (not a.title or not a.objective or not a.criterion):
            p.error("mission create needs a title, --objective, and at least one --criterion")
        if a.action in ("show", "cancel", "export"):
            try:
                a.id = int(a.title)
            except (TypeError, ValueError):
                p.error(f"mission {a.action} needs a numeric mission id")
        if a.action == "ros" and not a.title:
            p.error("mission ros needs the observed problem")
    if a.cmd == "capsule" and a.action == "show" and not a.id:
        p.error("capsule show needs a capsule id")
    if a.cmd == "workflow":
        if a.action == "create" and (not a.id or not a.title or
                                     (not a.from_mission and (not a.objective or not a.criterion))):
            p.error("workflow create needs ID, title, and --objective with at least one --criterion "
                    "(or --from-mission ID)")
        if a.action in ("show", "run") and not a.id:
            p.error(f"workflow {a.action} needs a workflow id")
    if a.cmd in (None, "help"):
        print(__doc__.strip())
    elif a.cmd == "autopilot":
        cmd_settings(a, autopilot=a.state == "on")
    elif a.cmd == "pause":
        cmd_settings(a, paused=True)
    elif a.cmd == "resume":
        cmd_settings(a, paused=False, clear_quota=True)
    elif a.cmd == "open":
        subprocess.Popen(["xdg-open", URL], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        globals()[f"cmd_{a.cmd.replace('-', '_')}"](a)


if __name__ == "__main__":
    main()
