<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: the computer's name, and five things done with one tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Adaptive Link"
        android:textColor="#98989D"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_lock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="Lock"
            android:textColor="#F5F5F7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_play_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="Play"
            android:textColor="#F5F5F7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="Next"
            android:textColor="#F5F5F7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_mute"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="Mute"
            android:textColor="#F5F5F7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_focus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="Focus"
            android:textColor="#F5F5F7"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
