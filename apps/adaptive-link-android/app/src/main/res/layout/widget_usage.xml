<?xml version="1.0" encoding="utf-8"?>
<!-- Compact enough for a 2x2 phone widget; a tap refreshes its last reading. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/usage_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/usage_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="AI usage"
        android:textColor="#F5F5F7"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/usage_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tap to check"
        android:textColor="#8E8E93"
        android:textSize="9sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/usage_codex_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Codex" android:textColor="#AEAEB2" android:textSize="11sp" />
            <TextView android:id="@+id/usage_codex_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="—" android:textColor="#8E8E93" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical">
            <TextView android:id="@+id/usage_claude_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Claude" android:textColor="#AEAEB2" android:textSize="11sp" />
            <TextView android:id="@+id/usage_claude_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="—" android:textColor="#8E8E93" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical">
            <TextView android:id="@+id/usage_gemini_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gemini" android:textColor="#AEAEB2" android:textSize="11sp" />
            <TextView android:id="@+id/usage_gemini_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="—" android:textColor="#8E8E93" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
