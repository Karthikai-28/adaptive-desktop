<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/usage_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/usage_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="✦  AI usage" android:textColor="#F5F5F7" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/usage_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxWidth="96dp" android:maxLines="1" android:text="Tap to check"
            android:textColor="#8E8E93" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PROVIDER" android:textColor="#8E8E93" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end" android:text="CURRENT" android:textColor="#8E8E93" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end" android:text="WEEK" android:textColor="#8E8E93" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="5dp">
            <TextView android:id="@+id/usage_codex_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Codex" android:textColor="#AEAEB2" android:textSize="12sp" />
            <TextView android:id="@+id/usage_codex_five" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end" android:text="—" android:textColor="#0A84FF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/usage_codex_week" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end" android:text="—" android:textColor="#0A84FF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="5dp">
            <TextView android:id="@+id/usage_claude_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Claude" android:textColor="#AEAEB2" android:textSize="12sp" />
            <TextView android:id="@+id/usage_claude_five" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end" android:text="—" android:textColor="#0A84FF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/usage_claude_week" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end" android:text="—" android:textColor="#0A84FF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingVertical="5dp">
            <TextView android:id="@+id/usage_gemini_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gemini" android:textColor="#AEAEB2" android:textSize="12sp" />
            <TextView android:id="@+id/usage_gemini_five" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end" android:text="—" android:textColor="#0A84FF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/usage_gemini_week" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end" android:text="—" android:textColor="#0A84FF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:id="@+id/usage_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="Refresh" android:textSize="12sp" android:textColor="#0A84FF" />
        <TextView android:id="@+id/usage_reconnect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="Reconnect" android:textSize="12sp" android:textColor="#0A84FF" />
    </LinearLayout>
</LinearLayout>
